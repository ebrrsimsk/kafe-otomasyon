<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SiparisActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Masa 1 - Sipariş Girişi"
        android:textColor="#003366"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="106dp"
        tools:layout_editor_absoluteY="31dp" />

    <HorizontalScrollView
        android:layout_width="403dp"
        android:layout_height="67dp"
        tools:layout_editor_absoluteX="4dp"
        tools:layout_editor_absoluteY="133dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button20"
                android:layout_width="135dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#003366"
                android:text="Sıcak İçecekler" />

            <Button
                android:id="@+id/button17"
                android:layout_width="131dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#003366"
                android:text="Soğuk İçecekler" />

            <Button
                android:id="@+id/button18"
                android:layout_width="131dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#003366"
                android:text="Tatlılar & Yemekler" />

            <Button
                android:id="@+id/button19"
                android:layout_width="132dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#003366"
                android:text="Dİiğer" />
        </LinearLayout>
    </HorizontalScrollView>

    <ListView
        android:layout_width="373dp"
        android:layout_height="346dp"
        tools:layout_editor_absoluteX="21dp"
        tools:layout_editor_absoluteY="210dp" />

    <Button
        android:id="@+id/button21"
        android:layout_width="178dp"
        android:layout_height="63dp"
        android:backgroundTint="#7CB342"
        android:text="Siparişi Onayla"
        tools:layout_editor_absoluteX="22dp"
        tools:layout_editor_absoluteY="627dp" />

    <Button
        android:id="@+id/button22"
        android:layout_width="184dp"
        android:layout_height="63dp"
        android:backgroundTint="#D32F2F"
        android:text="İptal Et / Geri Dön"
        tools:layout_editor_absoluteX="210dp"
        tools:layout_editor_absoluteY="627dp" />

</androidx.constraintlayout.widget.ConstraintLayout>